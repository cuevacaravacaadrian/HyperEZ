syntax hyperez "\.(hez|hz)$"
header "^#!.*hyper"
comment "//"
color brightblue "\<(if|else|elif|match|for|foreach|in|while|repeat|loop|do|break|continue|return|await|throw|try|catch|finally|step)\>"
color blue "\<(var|let|const|function|fn|class|struct|interface|enum|event|constructor|import|from|as|extends|implements|public|private|protected|static|async|get|set|and|or|not|is|new|on|once|emit|priority)\>"
color cyan "\<(number|int|float|double|text|string|char|bool|boolean|list|array|map|dict|set|any|object|void|null|function|Function|Task|Promise|Range|Event|Subscription)\>"
color brightyellow "\<(print|println|write|input|len|typeof|str|toNumber|toInt|assert|assertEqual|assertThrows|test|exit|range|time|now|wait|nextFrame|spawn|delay|tick|warn|createEvent|off|abs|sqrt|pow|floor|ceil|round|sign|min|max|clamp|lerp|sin|cos|tan|asin|acos|atan|atan2|hypot|exp|log|log10|radians|degrees|random|randomInt|randomChoice|randomSeed|remap|wrap|approach|smoothstep|chance|distance|isNaN|awaitAll|awaitAny|parseInt|gcd|lcm|factorial|isPrime|primes|divisors|cbrt|trunc|fract|sinh|cosh|tanh|randomGaussian|noise|chr|ord|Console|File|System|JSON|Vec2|Vec3|Color|Error|EventData|HyperCore|HyperMath|Process|Path|Time|Bytes|Hash|Base64|Regex|Http|Matrix|Image|ProcessHandle)\>"
color magenta "\<(true|false|null|this|super)\>"
color green "\<(0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9]+)?)\>"
color red ""([^"\\]|\\.)*"|'([^'\\]|\\.)*'"
color brightred "\$\{[^}]*\}"
color brightblack "//.*"
color brightblack start="/\*" end="\*/"
color ,green "[[:space:]]+$"
