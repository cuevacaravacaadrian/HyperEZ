}

/// Team note anchored to a point in the world: comments, tasks or ideas. Only visible in the editor.
class Note extends Instance {
    /// Note text.
    var text: text = ""

    /// Who wrote it.
    var author: text = ""

    /// World point where it is anchored.
    var position: Vec3 = Vec3(0, 0, 0)

    /// Marker colour.
    var color: Color = Color(255, 255, 255)

    /// Resolved (shown dimmed).
    var resolved: bool = false

    /// Creation date (seconds).
    var createdAt: number = 0
}

/// The running game: time, side (server/client) and the update event of every frame.
class Game {
    /// Game seconds since it started.
    static var time: number = 0

    /// Does this script run on the server?
    static var isServer: bool = false

    /// Does this script run on a client?
    static var isClient: bool = false

    /// Is it being tested in LPO Engine?
    static var isStudio: bool = false

    /// Every frame (dt = seconds since the previous one).
    static event update(dt: number)

    /// Simulación fuera del motor: ejecuta el bucle del juego durante unos segundos, lanzando update en cada fotograma.
    static async fn run(seconds: number = 1, fps: number = 60) {
        var dt = 1 / fps
        var fin = time + seconds
        while time < fin {
            await wait(dt)
            time += dt
            emit update(dt)
        }
    }
}

/// (Client) The player's keyboard, mouse and gamepad.
class Input {
    /// Is the key pressed? ("W", "Space", "Left", "LeftShift"...)
    static fn isKeyDown(key: text): bool { return _keys.contains(key) }

    /// Is the mouse button pressed? (1 left, 2 middle, 3 right)
    static fn isMouseDown(button: number = 1): bool { return _buttons.contains(button) }

    /// Mouse position in the game view (pixels).
    static var mousePosition: Vec2 = Vec2(0, 0)

    /// Mouse movement in this frame.
    static var mouseDelta: Vec2 = Vec2(0, 0)

    /// Game view size (pixels).
    static var viewSize: Vec2 = Vec2(0, 0)

    /// 3D world point under the mouse.
    static var mouseHit: Vec3 = Vec3(0, 0, 0)

    /// Part under the mouse (or null).
    static var mouseTarget: any = null

    /// Left stick of the gamepad (-1..1).
    static var gamepadStick: Vec2 = Vec2(0, 0)

    /// Mouse position in the 2D world (with the 2D camera).
    static var mouseWorld2D: Vec2 = Vec2(0, 0)

    /// A key was pressed.
    static event keyDown(key: text)

    /// A key was released.
    static event keyUp(key: text)

    /// A mouse button was pressed.
    static event mouseDown(button: number, position: Vec2)

    /// A mouse button was released.
    static event mouseUp(button: number, position: Vec2)

    /// The mouse wheel moved.
    static event mouseWheel(delta: number)

    private static var _keys: set = set()
    private static var _buttons: set = set()

    /// Simulación: pulsa una tecla (lanza keyDown).
    static fn press(key: text) {
        _keys.add(key)
        emit keyDown(key)
    }

    /// Simulación: suelta una tecla (lanza keyUp).
    static fn release(key: text) {
        _keys.remove(key)
        emit keyUp(key)
    }

    /// Simulación: hace clic con un botón del ratón (lanza mouseDown y mouseUp).
    static fn click(button: number = 1, position: Vec2 = Vec2(0, 0)) {
        mousePosition = position
        emit mouseDown(button, position)
        emit mouseUp(button, position)
    }
}

/// Tweens: animate number, Vec2, Vec3 and Color properties.
class Tween {
    /// Animates the properties to the given values. Curves: linear, quadIn, quadOut, quadInOut, cubicOut, sineInOut, backOut, bounceOut, elasticOut.
    static async fn to(target: any, props: map, duration: number, easing: text = "quadOut", delay: number = 0): any {
        if delay > 0 { await wait(delay) }
        var desde = {}
        foreach k in props.keys() { desde[k] = target[k] }
        var t = 0
        while t < duration {
            await wait(1 / 60)
            t = min(duration, t + 1 / 60)
            var f = _lpoEase(easing, duration <= 0 ? 1 : t / duration)
            foreach k in props.keys() { target[k] = _lpoLerp(desde[k], props[k], f) }
        }
        foreach k in props.keys() { target[k] = props[k] }
        return target
    }
}

/// Destroys objects after a while.
class Debris {
    /// Destroys the instance after the given seconds.
    static fn add(instance: any, seconds: number = 5) { delay(seconds, () => instance.destroy()) }
}

/// (Server) Data kept between sessions (scores, inventories...).
class DataStore {
    private static var _data: map = {}

    /// Stored value (or 'default').
    static fn get(key: text, default_: any = null): any { return _data.get(key, default_) }

    /// Stores a value (numbers, text, lists, maps...).
    static fn set(key: text, value: any) { _data[key] = value }

    /// Deletes a value.
    static fn remove(key: text) { _data.remove(key) }

    /// Claves guardadas.
    static fn keys(): list { return _data.keys() }
}

/// Game assets: reads imported text and data (JSON, CSV, dialogues, levels).
class Assets {
    /// Simulación: carpeta donde se buscan los recursos.
    static var folder: text = "assets"

    /// Contents of a text asset.
    static fn readText(name: text): text { return File.read(Path.join(folder, name)) }

    /// Reads a JSON asset as maps and lists.
    static fn readJson(name: text): any { return JSON.parse(readText(name)) }

    /// Reads a CSV table as a list of rows (each row a list of text).
    static fn readCsv(name: text): list { return readText(name).lines().filter(l => l.trim() != "").map(l => l.split(",")) }

    /// Does the asset exist?
    static fn exists(name: text): bool { return File.exists(Path.join(folder, name)) }

    /// Asset names (of one type: image, sound, text, font, mesh, song, spriteanim).
    static fn list(type: any = null): list { return [] }
}

/// Helpers for 2D games: find and create objects, floating text, particles, shake, slow motion, hit freeze, flashes, fades and zone queries.
class World2D {
    /// The first object in the 2D world with that name (searches everywhere).
    static fn find(name: text): any { return workspace2D.findDescendant(name) }

    /// Every object in the 2D world with that name or of that class.
    static fn findAll(nameOrClass: text): list { return workspace2D.descendants().filter(d => d.name == nameOrClass or d.isA(nameOrClass)) }

    /// Creates a copy of an object (for example kept in ReplicatedStorage) in the 2D world, at that position.
    static fn spawn(template: any, position: any = null, parent: any = null): any {
        var copia = template.clone()
        copia.parent = parent ?? workspace2D
        if position != null { copia.position = position }
        return copia
    }

    /// Floating text that rises and fades (damage, points, notices). The position can be an object.
    static fn popup(text: any, position: any, color: any = null, size: number = 12): any { return null }

    /// Particle burst from a ready-made effect (fire, smoke, sparks, explosion, magic, dust, confetti...) that clears itself.
    static fn burst(preset: text, position: any, count: number = 24): any { return null }

    /// Shakes the current 2D camera.
    static fn shake(intensity: number = 8, seconds: number = 0.35): void {}

    /// Freezes the 2D world for an instant: gives hits more impact.
    static fn hitStop(seconds: number = 0.08): Task { return wait(0) }

    /// Slow motion for a few seconds and a smooth return to normal.
    static fn slowMotion(scale: number = 0.3, seconds: number = 1): Task { return wait(0) }

    /// Full-screen flash.
    static fn flash(color: any = null, seconds: number = 0.25, amount: number = 0.75): Task { return wait(0) }

    /// Fade to a colour (black if none is given). Use it with await.
    static fn fadeOut(seconds: number = 0.6, color: any = null): Task { return wait(0) }

    /// Returns from the fade.
    static fn fadeIn(seconds: number = 0.6): Task { return wait(0) }

    /// Sprites touching a circle (explosions, attack ranges).
    static fn overlapCircle(center: any, radius: number): list { return [] }

    /// Ray from one point to another: {instance, position, normal, distance} of the first thing it hits, or null.
    static fn raycast(from: any, to: any, ignore: any = null): map? { return null }

    /// Distance between two objects or points.
    static fn distance(a: any, b: any): number { return (_lpoPoint(a) - _lpoPoint(b)).length() }

    /// Direction (length 1) from one object or point to another.
    static fn direction(from_: any, to: any): Vec2 { return (_lpoPoint(to) - _lpoPoint(from_)).normalized() }

    /// 2D time speed (1 normal, 0.3 slow, 0 frozen).
    static var timeScale: number = 0

    /// The current Camera2D (or null).
    static var camera: any = null

    /// Mouse position in the 2D world.
    static var mouse: Vec2 = Vec2(0, 0)
}

/// Timers: call a function after a while or every so often (game time).
class Timer {
    private static var _next: number = 1
    private static var _tasks: map = {}

    /// Calls the function once after the given seconds. Returns its number.
    static fn after(seconds: number, fn_: function): number {
        var id = _next++
        _tasks[id] = delay(seconds, fn_)
        return id
    }

    /// Calls the function every few seconds (forever or 'times' times). Returns its number.
    static fn every(seconds: number, fn_: function, times: any = null): number {
        var id = _next++
        _tasks[id] = spawn(async () => {
            var n = 0
            while times == null or n < times {
                await wait(seconds)
                fn_()
                n++
            }
        })
        return id
    }

    /// Stops a timer.
    static fn cancel(id: number) {
        var t = _tasks.get(id)
        if t != null { t.cancel() }
        _tasks.remove(id)
    }
}

/// How it blends with what is behind: Normal, Additive (adds light: fire, magic), Multiply (darkens), Screen (lightens).
const BlendMode2D = { Normal: "Normal", Additive: "Additive", Multiply: "Multiply", Screen: "Screen" }

/// 2D physics of a sprite.
const BodyType2D = { None: "None", Static: "Static", Dynamic: "Dynamic", Kinematic: "Kinematic" }

/// Player camera mode.
const CameraMode = { Classic: "Classic", LockFirstPerson: "LockFirstPerson" }

/// How the camera moves.
const CameraType = { Custom: "Custom", Scriptable: "Scriptable", Fixed: "Fixed" }

/// Zone where particles are born.
const EmissionShape2D = { Point: "Point", Circle: "Circle", Rectangle: "Rectangle", Ring: "Ring", Line: "Line" }

/// How the character faces the direction it moves.
const Facing2D = { None: "None", Flip: "Flip", Rotate: "Rotate" }

/// Joint type: hinge, fixed distance, spring, rope, weld or wheel (with suspension).
const JointType2D = { Revolute: "Revolute", Distance: "Distance", Spring: "Spring", Rope: "Rope", Weld: "Weld", Wheel: "Wheel" }

/// Point: lights a circle. Spot: a spotlight aimed by rotation (0 right, 90 down). Directional: a sun or moon lighting everything.
const LightType2D = { Point: "Point", Spot: "Spot", Directional: "Directional" }

/// Part material: changes the look (procedural texture, shine, reflections).
const Material = { Plastic: "Plastic", SmoothPlastic: "SmoothPlastic", Neon: "Neon", Metal: "Metal", Wood: "Wood", Glass: "Glass", Grass: "Grass", Brick: "Brick", Concrete: "Concrete", Ice: "Ice", Sand: "Sand", Fabric: "Fabric", Marble: "Marble", Slate: "Slate", ForceField: "ForceField" }

/// Shape of a part.
const PartShape = { Block: "Block", Ball: "Ball", Cylinder: "Cylinder", Wedge: "Wedge" }

/// Shape of each particle (when it has no image).
const ParticleShape2D = { Soft: "Soft", Circle: "Circle", Square: "Square", Spark: "Spark", Star: "Star", Ring: "Ring" }

/// Auto: 2D only when there are no 3D parts; Overlay: on top of 3D; Exclusive: 2D only; Off: not drawn.
const RenderMode2D = { Auto: "Auto", Overlay: "Overlay", Exclusive: "Exclusive", Off: "Off" }

/// Character skeleton: R15 (15 parts with elbows, knees, hands and feet) or R6 (6 parts).
const RigType = { R15: "R15", R6: "R6" }

/// How an image fits its box.
const ScaleType = { Stretch: "Stretch", Fit: "Fit" }

/// 2D shape (drawing without an image and collision).
const Shape2D = { Box: "Box", Circle: "Circle", RoundedBox: "RoundedBox", Capsule: "Capsule", Triangle: "Triangle", Polygon: "Polygon", Star: "Star", Ring: "Ring" }

/// Horizontal text alignment.
const TextXAlignment = { Left: "Left", Center: "Center", Right: "Right" }

/// Vertical text alignment.
const TextYAlignment = { Top: "Top", Center: "Center", Bottom: "Bottom" }

/// Image filtering: Pixel (crisp pixel art), Smooth (smoothed) or Auto.
const TextureFilter2D = { Auto: "Auto", Pixel: "Pixel", Smooth: "Smooth" }

