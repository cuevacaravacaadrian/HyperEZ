fn _lpoCreate(className: text): any {
    return match className {
        "Workspace" => Workspace(),
        "Workspace2D" => Workspace2D(),
        "Lighting" => Lighting(),
        "Players" => Players(),
        "Player" => Player(),
        "StarterPlayer" => StarterPlayer(),
        "StarterPlayerScripts" => StarterPlayerScripts(),
        "StarterCharacterScripts" => StarterCharacterScripts(),
        "StarterGui" => StarterGui(),
        "ReplicatedStorage" => ReplicatedStorage(),
        "ServerScriptService" => ServerScriptService(),
        "ServerStorage" => ServerStorage(),
        "SoundService" => SoundService(),
        "Teams" => Teams(),
        "Folder" => Folder(),
        "Model" => Model(),
        "BasePart" => BasePart(),
        "Part" => Part(),
        "SpawnLocation" => SpawnLocation(),
        "MeshPart" => MeshPart(),
        "UnionOperation" => UnionOperation(),
        "Camera" => Camera(),
        "Light" => Light(),
        "PointLight" => PointLight(),
        "SpotLight" => SpotLight(),
        "ParticleEmitter" => ParticleEmitter(),
        "WeldConstraint" => WeldConstraint(),
        "ClickDetector" => ClickDetector(),
        "Humanoid" => Humanoid(),
        "LuaSourceContainer" => LuaSourceContainer(),
        "Script" => Script(),
        "LocalScript" => LocalScript(),
        "ModuleScript" => ModuleScript(),
        "TouchScript" => TouchScript(),
        "ClickScript" => ClickScript(),
        "TimerScript" => TimerScript(),
        "PlayerScript" => PlayerScript(),
        "GuiScript" => GuiScript(),
        "ButtonScript" => ButtonScript(),
        "ValueBase" => ValueBase(),
        "StringValue" => StringValue(),
        "NumberValue" => NumberValue(),
        "BoolValue" => BoolValue(),
        "Vector3Value" => Vector3Value(),
        "ColorValue" => ColorValue(),
        "ObjectValue" => ObjectValue(),
        "RemoteEvent" => RemoteEvent(),
        "BindableEvent" => BindableEvent(),
        "Sound" => Sound(),
        "Animation" => Animation(),
        "Team" => Team(),
        "ScreenGui" => ScreenGui(),
        "GuiObject" => GuiObject(),
        "Frame" => Frame(),
        "TextLabel" => TextLabel(),
        "TextButton" => TextButton(),
        "TextBox" => TextBox(),
        "ImageLabel" => ImageLabel(),
        "ImageButton" => ImageButton(),
        "Node2D" => Node2D(),
        "Sprite2D" => Sprite2D(),
        "SpriteAnimator" => SpriteAnimator(),
        "ParticleEmitter2D" => ParticleEmitter2D(),
        "Tilemap2D" => Tilemap2D(),
        "Camera2D" => Camera2D(),
        "Light2D" => Light2D(),
        "Layer2D" => Layer2D(),
        "Water2D" => Water2D(),
        "Background2D" => Background2D(),
        "Line2D" => Line2D(),
        "Trail2D" => Trail2D(),
        "Joint2D" => Joint2D(),
        "PlatformerController2D" => PlatformerController2D(),
        "TopDownController2D" => TopDownController2D(),
        "Text2D" => Text2D(),
        "Note" => Note(),
        else => { throw Error("LPO Engine no tiene la clase '${className}'") }
    }
}

/// The game (root of everything).
var game = DataModel()
/// The 3D world.
var workspace = game.workspace
/// The 2D world.
var workspace2D = game.workspace2D
/// El script que se está ejecutando.
var script = Script(game.serverScriptService)
