/// Espera a que terminen todas las tareas y devuelve sus resultados en el mismo orden.
async function awaitAll(tareas: list): list {
    var resultados = []
    foreach t in tareas {
        resultados.add(await t)
    }
    return resultados
}

/// Ejecuta la función pasados unos segundos, sin detener el resto del programa. Devuelve su tarea.
async function delay(segundos: number, funcion: function, ...args: any): any {
    await wait(segundos)
    return funcion(...args)
}

/// Devuelve el resultado de la primera tarea que termine.
async function awaitAny(tareas: list): any {
    while true {
        foreach t in tareas {
            if t.done {
                return await t
            }
        }
        await nextFrame()
    }
}
